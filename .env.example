# Google Apps Script web app that saves RSVPs to a sheet (see README)
RSVP_WEBHOOK_URL=
# Same phrase as SECRET in the Apps Script
RSVP_WEBHOOK_SECRET=

# Password the two of you use to open the guest list (Couple login in the footer).
# At least 8 characters; a few words strung together is easiest to remember.
COUPLE_PASSWORD=
# Optional: link to your Google Sheet, shown as a button on the guest list
RSVP_SHEET_URL=

# Optional: your custom domain, used for link previews
NEXT_PUBLIC_SITE_URL=
